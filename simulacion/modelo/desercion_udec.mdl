{UTF-8}
Alertas nuevas=
	(Sem 1 + Sem 2) * Prob alerta
	~	Estudiantes/Semestre
	~	Alertas tempranas generadas en los semestres 1 y 2.
	|

Aplica media=
	1
	~	Dmnl [0,1,1]
	~	1 = la política cubre semestres 3-5.
	|

Aplica tardia=
	1
	~	Dmnl [0,1,1]
	~	1 = la política cubre semestres 6-10.
	|

Aplica temprana=
	1
	~	Dmnl [0,1,1]
	~	1 = la política cubre semestres 1-2.
	|

Avance 1=
	Sem 1 / TIME STEP - Desercion 1
	~	Estudiantes/Semestre
	~	Estudiantes que pasan del semestre 1 al 2. Requiere TIME STEP = 1 semestre.
	|

Avance 10=
	Sem 10 / TIME STEP - Desercion 10
	~	Estudiantes/Semestre
	~	Estudiantes que terminan el semestre 10.
	|

Avance 2=
	Sem 2 / TIME STEP - Desercion 2
	~	Estudiantes/Semestre
	~	Estudiantes que pasan del semestre 2 al 3. Requiere TIME STEP = 1 semestre.
	|

Avance 3=
	Sem 3 / TIME STEP - Desercion 3
	~	Estudiantes/Semestre
	~	Estudiantes que pasan del semestre 3 al 4. Requiere TIME STEP = 1 semestre.
	|

Avance 4=
	Sem 4 / TIME STEP - Desercion 4
	~	Estudiantes/Semestre
	~	Estudiantes que pasan del semestre 4 al 5. Requiere TIME STEP = 1 semestre.
	|

Avance 5=
	Sem 5 / TIME STEP - Desercion 5
	~	Estudiantes/Semestre
	~	Estudiantes que pasan del semestre 5 al 6. Requiere TIME STEP = 1 semestre.
	|

Avance 6=
	Sem 6 / TIME STEP - Desercion 6
	~	Estudiantes/Semestre
	~	Estudiantes que pasan del semestre 6 al 7. Requiere TIME STEP = 1 semestre.
	|

Avance 7=
	Sem 7 / TIME STEP - Desercion 7
	~	Estudiantes/Semestre
	~	Estudiantes que pasan del semestre 7 al 8. Requiere TIME STEP = 1 semestre.
	|

Avance 8=
	Sem 8 / TIME STEP - Desercion 8
	~	Estudiantes/Semestre
	~	Estudiantes que pasan del semestre 8 al 9. Requiere TIME STEP = 1 semestre.
	|

Avance 9=
	Sem 9 / TIME STEP - Desercion 9
	~	Estudiantes/Semestre
	~	Estudiantes que pasan del semestre 9 al 10. Requiere TIME STEP = 1 semestre.
	|

Calibracion=
	0.715
	~	Dmnl [0.3,1.5,0.005]
	~	Mínimos cuadrados ponderados de las tasas observadas en el CRUD frente al perfil SPADIES.
	|

Capacidad bienestar=
	21.5
	~	Estudiantes/Semestre [0,80,0.5]
	~	Casos que Bienestar atiende por semestre (CRUD: 21,6 apoyos por periodo).
	|

Casos atendidos=
	MIN(Casos pendientes / TIME STEP, Capacidad bienestar)
	~	Estudiantes/Semestre
	~	Casos que Bienestar alcanza a atender (recurso limitado).
	|

Casos pendientes= INTEG (
	Alertas nuevas - Casos atendidos - Casos vencidos,
		0)
	~	Estudiantes
	~	Cola de casos con alerta temprana que esperan atención de Bienestar.
	|

Casos vencidos=
	(Casos pendientes / TIME STEP - Casos atendidos) * Fraccion abandono cola
	~	Estudiantes/Semestre
	~	Casos no atendidos que salen de la cola.
	|

Cobertura bienestar=
	MIN(1, XIDZ(Casos atendidos, Casos pendientes / TIME STEP, 1))
	~	Dmnl
	~	Fracción de la cola que recibe atención en el semestre.
	|

CV desercion=
	0.236
	~	Dmnl [0,0.5,0.01]
	~	Coeficiente de variación de las tasas entre periodos.
	|

Desercion 1=
	Sem 1 * Tasa 1
	~	Estudiantes/Semestre
	~	Estudiantes que abandonan en el semestre 1.
	|

Desercion 10=
	Sem 10 * Tasa 10
	~	Estudiantes/Semestre
	~	Estudiantes que abandonan en el semestre 10.
	|

Desercion 2=
	Sem 2 * Tasa 2
	~	Estudiantes/Semestre
	~	Estudiantes que abandonan en el semestre 2.
	|

Desercion 3=
	Sem 3 * Tasa 3
	~	Estudiantes/Semestre
	~	Estudiantes que abandonan en el semestre 3.
	|

Desercion 4=
	Sem 4 * Tasa 4
	~	Estudiantes/Semestre
	~	Estudiantes que abandonan en el semestre 4.
	|

Desercion 5=
	Sem 5 * Tasa 5
	~	Estudiantes/Semestre
	~	Estudiantes que abandonan en el semestre 5.
	|

Desercion 6=
	Sem 6 * Tasa 6
	~	Estudiantes/Semestre
	~	Estudiantes que abandonan en el semestre 6.
	|

Desercion 7=
	Sem 7 * Tasa 7
	~	Estudiantes/Semestre
	~	Estudiantes que abandonan en el semestre 7.
	|

Desercion 8=
	Sem 8 * Tasa 8
	~	Estudiantes/Semestre
	~	Estudiantes que abandonan en el semestre 8.
	|

Desercion 9=
	Sem 9 * Tasa 9
	~	Estudiantes/Semestre
	~	Estudiantes que abandonan en el semestre 9.
	|

Desercion cohorte 10=
	100 * (1 - Retencion 10)
	~	Dmnl
	~	Deserción acumulada de cohorte a 10 semestres, en porcentaje.
	|

Desercion periodo=
	ZIDZ(Desercion total * TIME STEP, Matriculados)
	~	Dmnl
	~	Tasa de deserción por periodo (indicador SPADIES).
	|

Desercion rezago=
	Rezago * Tasa des rezago
	~	Estudiantes/Semestre
	~	
	|

Desercion total=
	Desercion 1 + Desercion 2 + Desercion 3 + Desercion 4 + Desercion 5 + Desercion 6 + Desercion 7 + Desercion 8 + Desercion 9 + Desercion 10 + Desercion rezago
	~	Estudiantes/Semestre
	~	Todas las salidas por deserción del semestre.
	|

Desertores= INTEG (
	Desercion total,
		0)
	~	Estudiantes
	~	Contador de desertores acumulados.
	|

Ef academico=
	0
	~	Dmnl [0,1,0.05]
	~	Efectividad de la palanca académica (monitorías).
	|

Ef adaptacion=
	0
	~	Dmnl [0,1,0.05]
	~	Efectividad de la palanca de adaptación (psicoorientación).
	|

Ef economico=
	0
	~	Dmnl [0,1,0.05]
	~	Efectividad de la palanca económica (becas, exoneraciones).
	|

Eficiencia titulacion=
	0.66
	~	Dmnl [0.3,1,0.01]
	~	Fracción que se gradúa al terminar el semestre 10 (CRUD: 0,664).
	|

Error conservacion=
	Ingresados acum - (Matriculados + Graduados + Desertores)
	~	Estudiantes
	~	Debe valer 0 en todo instante.
	|

Factor demanda=
	1
	~	Dmnl [0.5,1.5,0.05]
	~	1 = demanda actual; 1,25 = escenario de aumento de demanda.
	|

Fraccion abandono cola=
	0.5
	~	Dmnl [0,1,0.05]
	~	Supuesto: la mitad de los casos no atendidos sale de la cola cada semestre.
	|

Graduacion oportuna=
	Avance 10 * Eficiencia titulacion
	~	Estudiantes/Semestre
	~	
	|

Graduacion oportuna pct=
	100 * Retencion 10 * Eficiencia titulacion
	~	Dmnl
	~	Graduación oportuna de cohorte, en porcentaje.
	|

Graduacion rezago=
	Rezago * Tasa grad rezago
	~	Estudiantes/Semestre
	~	
	|

Graduados= INTEG (
	Graduacion oportuna + Graduacion rezago,
		0)
	~	Estudiantes
	~	Graduados acumulados.
	|

Graduados periodo=
	Graduacion oportuna + Graduacion rezago
	~	Estudiantes/Semestre
	~	
	|

Ingresados acum= INTEG (
	Ingreso,
		0)
	~	Estudiantes
	~	Contador de ingresos; se usa para verificar la conservación.
	|

Ingreso=
	IF THEN ELSE(Modo estocastico = 1, RANDOM NORMAL(Ingreso minimo, Ingreso maximo, Ingreso media, Ingreso de, Semilla), Ingreso media) * Factor demanda
	~	Estudiantes/Semestre
	~	Llegadas por semestre: Normal(65,8; 6,5) truncada en [50, 80], ajustada con las 21 cohortes exportadas del CRUD.
	|

Ingreso de=
	6.5
	~	Estudiantes/Semestre [0,15,0.1]
	~	Desviación estándar ajustada con el CRUD.
	|

Ingreso maximo=
	80
	~	Estudiantes/Semestre
	~	Truncamiento superior.
	|

Ingreso media=
	65.8
	~	Estudiantes/Semestre [50,80,0.1]
	~	Media ajustada con el CRUD.
	|

Ingreso minimo=
	50
	~	Estudiantes/Semestre
	~	Truncamiento inferior.
	|

Inicio politica=
	0
	~	Semestre [0,40,1]
	~	Semestre en que empiezan las políticas (0 = desde el inicio).
	|

Matriculados=
	Sem 1 + Sem 2 + Sem 3 + Sem 4 + Sem 5 + Sem 6 + Sem 7 + Sem 8 + Sem 9 + Sem 10 + Rezago
	~	Estudiantes
	~	
	|

Max reduccion=
	0.5
	~	Dmnl [0,1,0.05]
	~	Supuesto: reducción máxima de una tasa con política 100 % efectiva.
	|

Modo estocastico=
	1
	~	Dmnl [0,1,1]
	~	1 = llegadas y tasas aleatorias; 0 = corrida determinista.
	|

Multiplicador comun=
	Calibracion * Ruido desercion
	~	Dmnl
	~	Calibración institucional por choque aleatorio del periodo.
	|

Paso a rezago=
	Avance 10 * (1 - Eficiencia titulacion)
	~	Estudiantes/Semestre
	~	
	|

Peso aca media=
	0.5
	~	Dmnl
	~	Supuesto de trabajo.
	|

Peso aca tardia=
	0.4
	~	Dmnl
	~	Supuesto de trabajo.
	|

Peso aca temprana=
	0.3
	~	Dmnl
	~	Supuesto de trabajo.
	|

Peso ada media=
	0.2
	~	Dmnl
	~	Supuesto de trabajo.
	|

Peso ada tardia=
	0.2
	~	Dmnl
	~	Supuesto de trabajo.
	|

Peso ada temprana=
	0.4
	~	Dmnl
	~	Supuesto de trabajo.
	|

Peso eco media=
	0.3
	~	Dmnl
	~	Supuesto de trabajo.
	|

Peso eco tardia=
	0.4
	~	Dmnl
	~	Supuesto de trabajo.
	|

Peso eco temprana=
	0.3
	~	Dmnl
	~	Supuesto de trabajo.
	|

Politica activa=
	IF THEN ELSE(Time >= Inicio politica, 1, 0)
	~	Dmnl
	~	Vale 1 desde el semestre en que arrancan las políticas.
	|

Prob alerta=
	0.185
	~	1/Semestre
	~	Alertas por estudiante de semestres 1-2 en cada periodo (CRUD: 0,185).
	|

Reduccion media=
	Politica activa * Aplica media * Max reduccion * (Peso eco media * Ef economico + Peso aca media * Ef academico + Peso ada media * Ef adaptacion)
	~	Dmnl
	~	Reducción en semestres 3-5.
	|

Reduccion tardia=
	Politica activa * Aplica tardia * Max reduccion * (Peso eco tardia * Ef economico + Peso aca tardia * Ef academico + Peso ada tardia * Ef adaptacion)
	~	Dmnl
	~	Reducción en semestres 6-10.
	|

Reduccion temprana=
	Politica activa * Aplica temprana * Max reduccion * Cobertura bienestar * (Peso eco temprana * Ef economico + Peso aca temprana * Ef academico + Peso ada temprana * Ef adaptacion)
	~	Dmnl
	~	Reducción de la tasa en semestres 1-2. Se multiplica por la cobertura porque la ruta de apoyo empieza con la alerta temprana.
	|

Retencion 10=
	(1 - Tasa 1 * TIME STEP) * (1 - Tasa 2 * TIME STEP) * (1 - Tasa 3 * TIME STEP) * (1 - Tasa 4 * TIME STEP) * (1 - Tasa 5 * TIME STEP) * (1 - Tasa 6 * TIME STEP) * (1 - Tasa 7 * TIME STEP) * (1 - Tasa 8 * TIME STEP) * (1 - Tasa 9 * TIME STEP) * (1 - Tasa 10 * TIME STEP)
	~	Dmnl
	~	Fracción de una cohorte que termina el semestre 10 con las tasas vigentes.
	|

Rezago= INTEG (
	Paso a rezago - Graduacion rezago - Desercion rezago,
		0)
	~	Estudiantes
	~	Estudiantes que terminaron el semestre 10 sin graduarse.
	|

Ruido desercion=
	IF THEN ELSE(Modo estocastico = 1, RANDOM NORMAL(0.4, 1.6, 1, CV desercion, Semilla + 1), 1)
	~	Dmnl
	~	Variación de las tasas entre periodos. CV = 0,236, estimado con la deserción de primer semestre de 21 cohortes del CRUD.
	|

Sem 1= INTEG (
	Ingreso - Avance 1 - Desercion 1,
		0)
	~	Estudiantes
	~	Estudiantes matriculados en primer semestre.
	|

Sem 10= INTEG (
	Avance 9 - Graduacion oportuna - Paso a rezago - Desercion 10,
		0)
	~	Estudiantes
	~	Estudiantes en el semestre 10 (9 del plan más uno de margen).
	|

Sem 2= INTEG (
	Avance 1 - Avance 2 - Desercion 2,
		0)
	~	Estudiantes
	~	Estudiantes matriculados en el semestre 2.
	|

Sem 3= INTEG (
	Avance 2 - Avance 3 - Desercion 3,
		0)
	~	Estudiantes
	~	Estudiantes matriculados en el semestre 3.
	|

Sem 4= INTEG (
	Avance 3 - Avance 4 - Desercion 4,
		0)
	~	Estudiantes
	~	Estudiantes matriculados en el semestre 4.
	|

Sem 5= INTEG (
	Avance 4 - Avance 5 - Desercion 5,
		0)
	~	Estudiantes
	~	Estudiantes matriculados en el semestre 5.
	|

Sem 6= INTEG (
	Avance 5 - Avance 6 - Desercion 6,
		0)
	~	Estudiantes
	~	Estudiantes matriculados en el semestre 6.
	|

Sem 7= INTEG (
	Avance 6 - Avance 7 - Desercion 7,
		0)
	~	Estudiantes
	~	Estudiantes matriculados en el semestre 7.
	|

Sem 8= INTEG (
	Avance 7 - Avance 8 - Desercion 8,
		0)
	~	Estudiantes
	~	Estudiantes matriculados en el semestre 8.
	|

Sem 9= INTEG (
	Avance 8 - Avance 9 - Desercion 9,
		0)
	~	Estudiantes
	~	Estudiantes matriculados en el semestre 9.
	|

Semilla=
	1
	~	Dmnl [1,100,1]
	~	Semilla de números aleatorios. Se cambia en cada réplica (1 a 10).
	|

Tasa 1=
	Tasa base 1 * Multiplicador comun * (1 - Reduccion temprana)
	~	1/Semestre
	~	Tasa de deserción por periodo del semestre 1.
	|

Tasa 10=
	Tasa base 10 * Multiplicador comun * (1 - Reduccion tardia)
	~	1/Semestre
	~	Tasa de deserción por periodo del semestre 10.
	|

Tasa 2=
	Tasa base 2 * Multiplicador comun * (1 - Reduccion temprana)
	~	1/Semestre
	~	Tasa de deserción por periodo del semestre 2.
	|

Tasa 3=
	Tasa base 3 * Multiplicador comun * (1 - Reduccion media)
	~	1/Semestre
	~	Tasa de deserción por periodo del semestre 3.
	|

Tasa 4=
	Tasa base 4 * Multiplicador comun * (1 - Reduccion media)
	~	1/Semestre
	~	Tasa de deserción por periodo del semestre 4.
	|

Tasa 5=
	Tasa base 5 * Multiplicador comun * (1 - Reduccion media)
	~	1/Semestre
	~	Tasa de deserción por periodo del semestre 5.
	|

Tasa 6=
	Tasa base 6 * Multiplicador comun * (1 - Reduccion tardia)
	~	1/Semestre
	~	Tasa de deserción por periodo del semestre 6.
	|

Tasa 7=
	Tasa base 7 * Multiplicador comun * (1 - Reduccion tardia)
	~	1/Semestre
	~	Tasa de deserción por periodo del semestre 7.
	|

Tasa 8=
	Tasa base 8 * Multiplicador comun * (1 - Reduccion tardia)
	~	1/Semestre
	~	Tasa de deserción por periodo del semestre 8.
	|

Tasa 9=
	Tasa base 9 * Multiplicador comun * (1 - Reduccion tardia)
	~	1/Semestre
	~	Tasa de deserción por periodo del semestre 9.
	|

Tasa base 1=
	0.204
	~	1/Semestre
	~	Tasa por periodo del perfil SPADIES, semestre 1.
	|

Tasa base 10=
	0.024
	~	1/Semestre
	~	Tasa por periodo del perfil SPADIES, semestre 10.
	|

Tasa base 2=
	0.117
	~	1/Semestre
	~	Tasa por periodo del perfil SPADIES, semestre 2.
	|

Tasa base 3=
	0.087
	~	1/Semestre
	~	Tasa por periodo del perfil SPADIES, semestre 3.
	|

Tasa base 4=
	0.076
	~	1/Semestre
	~	Tasa por periodo del perfil SPADIES, semestre 4.
	|

Tasa base 5=
	0.074
	~	1/Semestre
	~	Tasa por periodo del perfil SPADIES, semestre 5.
	|

Tasa base 6=
	0.06
	~	1/Semestre
	~	Tasa por periodo del perfil SPADIES, semestre 6.
	|

Tasa base 7=
	0.054
	~	1/Semestre
	~	Tasa por periodo del perfil SPADIES, semestre 7.
	|

Tasa base 8=
	0.033
	~	1/Semestre
	~	Tasa por periodo del perfil SPADIES, semestre 8.
	|

Tasa base 9=
	0.023
	~	1/Semestre
	~	Tasa por periodo del perfil SPADIES, semestre 9.
	|

Tasa des rezago=
	0.04
	~	1/Semestre
	~	CRUD: 0,039.
	|

Tasa grad rezago=
	0.12
	~	1/Semestre
	~	CRUD: 0,119.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 40
	~	Semestre
	~	Final de la simulación (20 años).
	|

INITIAL TIME  = 0
	~	Semestre
	~	Inicio de la simulación.
	|

SAVEPER  = 
        TIME STEP
	~	Semestre [0,?]
	~	Frecuencia de guardado.
	|

TIME STEP  = 1
	~	Semestre [0,?]
	~	Paso de integración: un semestre. No cambiar: el avance entre semestres lo supone.
	|

